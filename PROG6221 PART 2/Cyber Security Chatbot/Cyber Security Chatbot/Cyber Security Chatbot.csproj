<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cyber Security Chatbot</AssemblyName>
    <RootNamespace>CyberSecurityChatbot</RootNamespace>
    <Product>Cyber Security Chatbot</Product>
    <Title>Cyber Security Chatbot</Title>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\CyberSecurityGreeting.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\CyberSecurityGreeting.m4a">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
